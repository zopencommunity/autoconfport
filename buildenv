#!/bin/sh
#
# Set up environment variables for general build tool to operate
#
# Note: requires zlib to be installed into system as pre-req
# bump: autoconf-version /AUTOCONF_VERSION="(.*)"/ https://ftp.gnu.org/gnu/autoconf/|re:/href="autoconf-([\d.]+).tar.gz"/$1/|semver:*
AUTOCONF_VERSION="2.73"
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_STABLE_URL="https://ftp.gnu.org/gnu/autoconf/autoconf-${AUTOCONF_VERSION}.tar.gz"
export ZOPEN_STABLE_DEPS="make m4 perl zlib texinfo bash flex diffutils coreutils grep sed gawk"

export ZOPEN_DEV_URL="https://github.com/autotools-mirror/autoconf.git"
export ZOPEN_DEV_DEPS="git make m4 perl autoconf automake help2man texinfo xz zlib bash flex"

export ZOPEN_EXTRA_CFLAGS=""
export ZOPEN_EXTRA_LDFLAGS=""
export PERL="/bin/env perl"

export ZOPEN_RUNTIME_DEPS="perl m4"

export ZOPEN_CHECK_TIMEOUT=100000 # ~30 hours

zopen_append_to_env()
{
cat <<EOF
export autom4te_perllibdir=\${PWD}/share/autoconf
export AC_MACRODIR=\${PWD}/share/autoconf

# To set M4 variable path
if [ ! -z "\${M4_HOME}"  ]; then
    export M4="\$M4_HOME/bin/m4"
fi

EOF
}

zopen_check_results()
{
  chk="$1/$2_check.log"

  # Parse test results from the ERROR summary line
  eval $(awk '
    /^ERROR:/ {
      match($0, /([0-9]+) tests were run/, total);
      ac_totalTests = total[1];
    }
    /failed.*expected failures/ {
      match($0, /([0-9]+) failed.*\(([0-9]+) expected/, fail);
      ac_failures = fail[1] - fail[2];
      ac_expectedFailures = fail[2];
    }
    /tests were skipped/ {
      match($0, /([0-9]+) tests were skipped/, skip);
      ac_skipped = skip[1];
    }
    END {
      ac_success = ac_totalTests - (ac_failures + ac_expectedFailures + ac_skipped);
      print "ac_totalTests=" ac_totalTests;
      print "ac_failures=" ac_failures;
      print "ac_expectedFailures=" ac_expectedFailures;
      print "ac_skipped=" ac_skipped;
      print "ac_success=" ac_success;
    }
  ' ${chk})

  let actualFailures=${ac_failures}
  let totalTests=${ac_totalTests}+${ac_skipped}
  let expectedFailures=13

  cat <<ZZ
actualFailures:$actualFailures
totalTests:$totalTests
expectedFailures:$expectedFailures
ZZ
}

zopen_get_version()
{
  ./bin/autoconf --version | head -1 | awk '{print $4; }'
}
